                "tags": [
                    "service"
                ],
                "summary": "Auth test",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.FlagDTO"
                        }
                    }
                }
            }
        },
        "/service/health": {
            "get": {
                "description": "Check if the server is running",
                "tags": [
                    "service"
                ],
                "summary": "Health check",
                "responses": {
